#!/bin/sh
set -eu

usage() {
  echo "usage: pre-commit [--unstaged | --all]" >&2
  echo "  (no args)  check staged files" >&2
  echo "  --unstaged check unstaged and untracked files instead" >&2
  echo "  --all      check all tracked files" >&2
}

case "${1:-}" in
  "")
    selected_files=$(git diff --cached --name-only --diff-filter=ACMR)
    mode_label="staged"
    ;;
  --unstaged)
    selected_files=$(git diff --name-only --diff-filter=ACMR)
    selected_files="$selected_files
$(git ls-files --others --exclude-standard)"
    mode_label="unstaged"
    ;;
  --all)
    selected_files=$(git ls-files)
    mode_label="all"
    ;;
  *)
    usage
    exit 1
    ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

TMP_ROOT=${TMPDIR:-/tmp}/tests-ytptube
mkdir -p "$TMP_ROOT"
PIDS_FILE=$(mktemp "$TMP_ROOT/ytptube-precommit.XXXXXX")
trap 'rm -f "$PIDS_FILE"' EXIT

export CI=1
checks_started=0
run_step() {
  local label="$1"
  shift
  checks_started=1
  echo "Starting $label..." >&2
  (
    if ! "$@"; then
      echo "[$label] failed. $mode_label run failed." >&2
      exit 1
    else
      echo "[$label] passed." >&2
    fi
  ) &
  echo $! >>"$PIDS_FILE"
}

run_extra_dir() {
  local scope="$1"
  local dir="$2"
  for step in "$dir"/*; do
    [ -f "$step" ] && [ -x "$step" ] || continue
    run_step "Extra ($scope): $(basename "$step")" "$step"
  done
}

echo "Running pre-commit checks ($mode_label)... ${REPO_ROOT}" >&2
python_changed=0
frontend_changed=0

while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$path" in
    app/* | pyproject.toml | uv.lock | app.spec)
      python_changed=1
      ;;
    .editorconfig)
      python_changed=1
      frontend_changed=1
      ;;
  esac
  case "$path" in
    ui/*)
      frontend_changed=1
      ;;
  esac
done <<EOF
$selected_files
EOF

if [ "$frontend_changed" -eq 1 ]; then
  echo "Preparing frontend..." >&2
  NODE_ENV=development bun --cwd=./ui run nuxt prepare --envName=development
  echo "Frontend preparation passed." >&2
fi

if [ "$python_changed" -eq 1 ]; then
  run_step "Python: Formatter" uv run ruff format --check app/
  run_step "Python: Linter" uv run ruff check app/
  run_step "Python: TY Linter" uv run ty check app/
  run_step "Python: Tests" uv run pytest app/ -q
fi

if [ "$frontend_changed" -eq 1 ]; then
  run_step "Frontend: Formatter" bun --cwd=./ui run format:check
  run_step "Frontend: i18n" bun --cwd=./ui run i18n:check
  run_step "Frontend: Linter" bun --cwd=./ui run lint:ci
  run_step "Frontend: Tests" bun --cwd=./ui test:ci
  run_step "Frontend: TSC" bun --cwd=./ui run lint:tsc
fi

extra_dir=$(git rev-parse --git-path hooks)/pre-commit.d
run_extra_dir "Global" "$extra_dir"
if [ "$python_changed" -eq 1 ]; then
  run_extra_dir "Backend" "$extra_dir/backend"
fi
if [ "$frontend_changed" -eq 1 ]; then
  run_extra_dir "Frontend" "$extra_dir/frontend"
fi

if [ "$checks_started" -eq 0 ]; then
  echo "No checks apply to the $mode_label files."
  exit 0
fi

fail=0
while read -r pid; do
  if ! wait "$pid"; then
    fail=1
  fi
done <"$PIDS_FILE"

if [ "$fail" -eq 1 ]; then
  echo "[X] One or more checks failed. $mode_label run failed." >&2
  exit 1
fi

echo "All checks passed."
exit 0
